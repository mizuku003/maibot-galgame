{
  "manifest_version": 2,
  "id": "mizuku003.galgame",
  "version": "1.0.0",
  "name": "galgame领域大神",
  "description": "多源 galgame 资料查询：中文名与汉化、通关时长与标签、评分与玩家锐评，支持别名检索、条件推荐、资料卡出图与 /锐评；附带 gal 圈情报与贴吧话术学习。",
  "author": {
    "name": "mizuku003",
    "url": "https://github.com/mizuku003"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/mizuku003/maibot-galgame",
    "homepage": "https://github.com/mizuku003/maibot-galgame",
    "documentation": "https://github.com/mizuku003/maibot-galgame/blob/main/README.md",
    "issues": "https://github.com/mizuku003/maibot-galgame/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.26.0"
    }
  ],
  "capabilities": [
    "config.get",
    "llm.generate",
    "render.html2png",
    "send.image",
    "send.text",
    "send.forward",
    "chat.get_all_streams",
    "database.query",
    "database.get",
    "database.save",
    "database.delete"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "gamepad-2",
      "fallback": "gamepad"
    }
  }
}
